# Command Board service (services/command-board)
# Canonical store + REST API for the Quantum Command Board (TRK-0686).

# Port/host the API listens on (default 8798 on 127.0.0.1).
PORT=8798
HOST=127.0.0.1

# SQLite path (default ./data/command-board.db)
BOARD_DB=./data/command-board.db

# Optional Bearer token required on /api/* (leave unset for local dev;
# production sits behind the Solorion login seam).
# BOARD_TOKEN=
